--
-- Unit tests for the RobDP support code added in step S1: the per-sample
-- vector type, the debug dump format and the GUCs.
--
CREATE EXTENSION test_robust;
-- RobustVec API (raises an error naming the failed check)
SELECT test_robustvec();
 test_robustvec 
----------------
 ok
(1 row)

-- Exact dump format: %.17g numbers, "nan"/"inf" strings, JSON escaping
SET client_min_messages = log;
SELECT test_robust_dump();
LOG:  ROBDP {"ev":"test","s":"quote\" backslash\\ tab\t é","null_s":null,"i":-9223372036854775808,"big":1.2345678901234568e+17,"ninf":"-inf","t":true,"f":false,"v":[0.10000000000000001,0.33333333333333331,1e-300,"nan","inf",-0],"c":[2],"null_v":null}
 test_robust_dump 
------------------
 
(1 row)

RESET client_min_messages;
-- Defaults: robust planning is off
SELECT name, setting, context FROM pg_settings
WHERE name IN ('enable_rows_dist', 'error_sample_count', 'error_sample_seed',
               'error_bin_count', 'error_sample_kde_bandwidth',
               'error_profile_path', 'robust_debug_dump')
ORDER BY name;
            name            | setting |  context  
----------------------------+---------+-----------
 enable_rows_dist           | off     | user
 error_bin_count            | 1       | user
 error_profile_path         |         | superuser
 error_sample_count         | 20      | user
 error_sample_kde_bandwidth | 0       | user
 error_sample_seed          | 42      | user
 robust_debug_dump          | off     | superuser
(7 rows)

-- Ranges
SET error_sample_count = 0;
ERROR:  0 is outside the valid range for parameter "error_sample_count" (1 .. 1000)
SET error_sample_count = 1001;
ERROR:  1001 is outside the valid range for parameter "error_sample_count" (1 .. 1000)
SET error_sample_count = 1;
SET error_sample_count = 1000;
SET error_bin_count = 9;
ERROR:  9 is outside the valid range for parameter "error_bin_count" (1 .. 8)
SET error_sample_kde_bandwidth = -1.5;
ERROR:  -1.5 is outside the valid range for parameter "error_sample_kde_bandwidth" (-1 .. 10)
RESET ALL;
-- The profile directory and the dump are superuser-only: an ordinary user
-- must not make the server read files or flood the log
CREATE ROLE regress_robust_user;
SET ROLE regress_robust_user;
SET error_profile_path = '/tmp';
ERROR:  permission denied to set parameter "error_profile_path"
SET robust_debug_dump = on;
ERROR:  permission denied to set parameter "robust_debug_dump"
SET enable_rows_dist = on;
SET error_sample_count = 5;
RESET ROLE;
RESET ALL;
DROP ROLE regress_robust_user;
-- The "query" event of standard_planner
SET robust_debug_dump = on;
SET error_sample_count = 7;
SET client_min_messages = log;
SELECT 1 AS one;
LOG:  ROBDP {"ev":"query","enabled":false,"N":7,"seed":42,"bins":1,"bandwidth":0,"profile_path":""}
 one 
-----
   1
(1 row)

RESET client_min_messages;
RESET ALL;
-- Error profiles (S2).  Files are written to the data directory, and
-- error_profile_path = '.' (the server's working directory is the data
-- directory), so that messages show stable paths.
CREATE TEMP TABLE prof (line text);
INSERT INTO prof VALUES
  ('# comment and blank lines are ignored'), (''),
  ('0.5 0.1'), ('0.01 0.1'), ('0.2 0.2'), ('0 0.3'), ('1 0.9'), ('0.9 0.9'),
  ('not a number'), ('0.5'), ('0.5 0.5 0.5'), ('1.5 0.5'), ('0.5 -0.1'), ('nan 0.5');
DO $$ BEGIN
  EXECUTE format('COPY prof TO %L', current_setting('data_directory') || '/rt_a.txt');
  EXECUTE format('COPY (SELECT ''x y'') TO %L', current_setting('data_directory') || '/rt_empty.txt');
END $$;
SET error_profile_path = '.';
SET error_bin_count = 2;
SET robust_debug_dump = on;
SET client_min_messages = log;
-- 6 valid points, 6 invalid lines (5 reported one by one, then a total);
-- bins: sel_est {0.1, 0.1, 0.2} and {0.3, 0.9, 0.9}
SELECT test_robust_profile('rt_a', '{0, 0.1, 0.15, 0.2, 0.25, 0.9, 1}');
LOG:  ROBDP {"ev":"query","enabled":false,"N":20,"seed":42,"bins":2,"bandwidth":0,"profile_path":"."}
WARNING:  RobDP: skipping invalid line 9 of error profile "./rt_a.txt"
DETAIL:  Each line must be "sel_true sel_est", two numbers in [0, 1].
WARNING:  RobDP: skipping invalid line 10 of error profile "./rt_a.txt"
DETAIL:  Each line must be "sel_true sel_est", two numbers in [0, 1].
WARNING:  RobDP: skipping invalid line 11 of error profile "./rt_a.txt"
DETAIL:  Each line must be "sel_true sel_est", two numbers in [0, 1].
WARNING:  RobDP: skipping invalid line 12 of error profile "./rt_a.txt"
DETAIL:  Each line must be "sel_true sel_est", two numbers in [0, 1].
WARNING:  RobDP: skipping invalid line 13 of error profile "./rt_a.txt"
DETAIL:  Each line must be "sel_true sel_est", two numbers in [0, 1].
WARNING:  RobDP: skipped 6 invalid lines of error profile "./rt_a.txt" in all
LOG:  ROBDP {"ev":"profile","key":"rt_a","path":"./rt_a.txt","n":6,"skipped":6,"bins":[{"first":0,"n":3,"lo":"-inf","hi":0.20000000000000001,"mean":-0.23104906018664853,"sd":1.966219405333397,"h":1.2414497599046863},{"first":3,"n":3,"lo":0.20000000000000001,"hi":0.90000000000000002,"mean":-8.7738959319815955,"sd":15.28816918120526,"h":11.045203924477804}]}
 test_robust_profile 
---------------------
 {0,0,0,0,1,1,1}
(1 row)

-- cached: no second load, no warnings
SELECT test_robust_profile('rt_a', '{0.2}');
LOG:  ROBDP {"ev":"query","enabled":false,"N":20,"seed":42,"bins":2,"bandwidth":0,"profile_path":"."}
 test_robust_profile 
---------------------
 {0}
(1 row)

-- a new bin count rebuilds the bins; the two points with sel_est 0.9 are
-- not split across bins, so the bin sizes are 2, 1, 3, 0
SET error_bin_count = 4;
SELECT test_robust_profile('rt_a', '{0.1, 0.2, 0.3, 0.9}');
